DATABASE_URL=postgresql://autoflow:autoflow@localhost:5432/autoflow
MIGRATION_MAX_ATTEMPTS=12
MIGRATION_RETRY_SECONDS=5
BOT_TOKEN=
# Optional TELEGRAM_MINI_APP_SHORT_NAME: set only for a real BotFather short_name.
# Leave unset for Main Mini App (/startapp is detected via getMe) or /start fallback.
TELEGRAM_WEBHOOK_SECRET=
ADMIN_ID=123456789
ADMIN_TELEGRAM_IDS=
PUBLIC_BASE_URL=
UPLOAD_DIR=
MIN_WITHDRAWAL_AF_COINS=100
LISTING_PROMOTION_COST_AF_COINS=15
LISTING_PROMOTION_HOURS=24
# Special offer after the stored VIP period expires; regular pin tariff unchanged.
VIP_RENEWAL_PRICE_STARS=10
VIP_RENEWAL_HOURS=72
VIP_EXPIRY_NOTIFICATIONS_ENABLED=true
TRAINING_DELIVERY_COOLDOWN_SECONDS=300
# Seconds after paid purchase; [] disables seller reminders. Does NOT change the 24h refund deadline.
SELLER_ORDER_REMINDER_SECONDS=[7200,43200,82800]
SELLER_PAYOUT_PERCENT=100
TRAINING_SELLER_PAYOUT_PERCENT=70
PAYOUT_NFT_THRESHOLD_STARS=350
STAR_TOPUP_MIN=100
STAR_TOPUP_MAX=1000
# Source/wire limit before server normalization (JPEG output <= 2 MiB, 64 MP).
UPLOAD_MAX_BYTES=67108864
DEBUG=true
DEV_TELEGRAM_ID=123456789
DEV_TELEGRAM_NAME=Local Admin
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Account sales are opt-in. Supply keys through the secret manager, never Git.
ACCOUNT_SALES_ENABLED=false
ACCOUNT_SECRET_KEYS={}
ACCOUNT_SECRET_ACTIVE_KEY=
ACCOUNT_SECRET_RETENTION_DAYS=1
ACCOUNT_S3_ENDPOINT=
ACCOUNT_S3_REGION=auto
ACCOUNT_S3_BUCKET=
ACCOUNT_S3_ACCESS_KEY=
ACCOUNT_S3_SECRET_KEY=
ACCOUNT_VIDEO_MAX_BYTES=104857600
